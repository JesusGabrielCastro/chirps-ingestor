# MongoDB — catálogo de archivos procesados
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=chirps_catalog

# MinIO — almacenamiento de GeoTIFFs cortados
MINIO_URL=localhost:9000
MINIO_USER=chirps_admin
MINIO_PASSWORD=chirps_local_pass
MINIO_BUCKET=chirps
MINIO_SECURE=false

# Selenium — Chrome driver
CHROMEDRIVER_PATH=/usr/bin/chromedriver
# O usar selenium-manager (auto-descarga el driver)

# Configuración de ingesta
BATCH_SIZE=6
MAX_DOWNLOAD_RETRIES=3
DOWNLOAD_TIMEOUT_SECONDS=180
RATE_LIMIT_SECONDS=2     # pausa entre descargas para no saturar UCSB

# Logging
LOG_LEVEL=INFO
